# AI-CAC Configuration
# Copy this file to .env and update with your values
# Used by both direct Python execution and Docker Compose

# ========================================
# S3 Storage Configuration
# ========================================

# Enable S3 storage (set to true to use S3, false for local storage)
USE_S3_STORAGE=true

# S3 bucket name (required if USE_S3_STORAGE=true)
S3_BUCKET_NAME={BUCKET_NAME}

# AWS region (default: us-east-1)
AWS_REGION={AWS_REGION}

# S3 key prefix for all uploads (default: RADFLOW/outputs/ai-cac-outputs)
S3_PREFIX=RADFLOW/outputs/ai-cac-outputs

# Presigned URL expiration in seconds (default: 3600 = 1 hour)
S3_URL_EXPIRATION=3600

# ========================================
# AWS Credentials
# ========================================
# Option 1: Use environment variables (not recommended for production)

AWS_ACCESS_KEY_ID={ACCESS_ID}
AWS_SECRET_ACCESS_KEY={SECRET_KEY}

# Option 2: Use IAM role (recommended for EC2/ECS/Lambda) - no credentials needed
# Option 3: Use ~/.aws/credentials file - no environment variables needed

# ========================================
# Model Configuration
# ========================================

# Path to model checkpoint file
MODEL_CHECKPOINT_FILE=model/va_non_gated_ai_cac_model.pth

# Inference batch size
INFERENCE_BATCH_SIZE=32

# DataLoader worker processes (0=single-threaded, 4-8 recommended for multi-core)
DATALOADER_NUM_WORKERS=4

# ========================================
# Flask Configuration
# ========================================

# Flask debug mode (set to false in production)
FLASK_DEBUG=false

# Flask host (0.0.0.0 to accept external connections)
FLASK_HOST=0.0.0.0

# Flask port
FLASK_PORT=25000